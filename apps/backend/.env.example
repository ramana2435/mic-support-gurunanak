# Server Configuration
NODE_ENV=development
PORT=3002
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=8RPUaJxf9hC58sTvJbABulKrnf+8QaUsXMJYz6b4xko=
JWT_EXPIRES_IN=7d

# Database Configuration
# IMPORTANT: Replace <YOUR_POSTGRES_PASSWORD> with your actual PostgreSQL password
# Port 5433 is used (not the default 5432)
DATABASE_URL=postgresql://postgres:<ramana>@localhost:5433/mic_support

# Redis Configuration (Optional for Phase 1)
# REDIS_URL=redis://localhost:6379

# Session Configuration
MAX_STUDENTS_PER_SESSION=100
SESSION_CODE_LENGTH=6
SESSION_EXPIRY_HOURS=24

# Groq API Configuration (STT and Translation)
GROQ_API_KEY=your_groq_api_key_here

# Google Cloud Text-to-Speech Configuration
# Option 1: Path to service account JSON key file (recommended for local development)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-cloud-key.json

# Option 2: Inline JSON key (recommended for production/Railway)
# GOOGLE_CLOUD_KEY_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Logging
LOG_LEVEL=info
